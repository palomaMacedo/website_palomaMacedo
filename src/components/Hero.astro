---
import { Image } from 'astro:assets';
import palomaHero from '../assets/images/paloma.png';
---

<section
  id="hero"
  class="relative -mt-20 min-h-[calc(100svh-96px)] overflow-hidden bg-yellow-300 [clip-path:polygon(0_10%,100%_0,100%_86%,0_100%)]"
>
  <div
    class="relative mx-auto min-h-[calc(100svh-96px)] max-w-7xl px-6 md:px-10"
  >
    <div class="relative z-20 pt-32 md:w-3/5 md:pt-24">
      <div class="-rotate-2">
        <p
          class="font-sans text-base font-extrabold tracking-wide text-emerald-600 uppercase"
        >
          A Field Guide to Digital Experiences
        </p>

        <div class="h-1 w-20 -rotate-2 rounded-full bg-emerald-600"></div>
      </div>

      <h1
        class="font-display mt-6 font-extrabold tracking-[-0.03em] text-black uppercase"
      >
        <span class="leading-8xl block text-8xl"> Making </span>

        <span class="leading-8xl block text-8xl md:text-8xl"> Complex </span>

        <span class="leading-8xl block text-8xl md:text-8xl">
          Things Feel
        </span>

        <span class="leading-8xl block text-8xl md:text-8xl"> Obvious. </span>
      </h1>

      <p
        class="mt-7 font-mono text-base leading-relaxed font-black text-black/80"
      >
        I design digital experiences where<br />
        technology makes sense to people.
      </p>

      <a
        href="#about"
        class="group mt-8 inline-flex -rotate-2 items-center gap-5 bg-black px-7 py-5 font-mono text-[18px] leading-none font-bold tracking-[0.03em] text-white uppercase shadow-[8px_8px_0_#059669] transition-transform duration-300 hover:-translate-y-1"
      >
        <span>Explore the guide</span>

        <span
          aria-hidden="true"
          class="text-4xl font-bold text-emerald-500 transition-transform duration-300 ease-out group-hover:translate-x-2"
        >
          →
        </span>
      </a>
    </div>

    <div
      class="relative z-10 mx-auto mt-12 w-4/5 max-w-xl md:absolute md:right-30 md:bottom-12 md:mt-0 md:w-1/2 md:max-w-4xl"
    >
      <Image
        src={palomaHero}
        alt="Paloma Macedo"
        class="h-auto w-full"
        loading="eager"
      />
    </div>
    <div
      class="absolute top-[70%] right-20 z-30 flex w-36 rotate-[-10deg] bg-white px-5 py-5 shadow-[6px_6px_0_rgba(0,0,0,0.08)]"
    >
      <p class="font-mono text-base leading-[1.05] font-black text-black">
        15+ Years<br />
        Building<br />
        Digital Things<br />
        That Matter.
      </p>
    </div>
    <div
      class="absolute top-1/4 -right-2 z-30 flex h-40 w-40 rotate-3 flex-col items-center justify-center rounded-full bg-emerald-600 text-center"
    >
      <p
        class="font-sans text-xl leading-[1.05] font-black text-white uppercase"
      >
        For<br />
        <span class="text-yellow-300">Curious</span><br />
        People.
      </p>

      <div class="mt-2 h-1 w-14 bg-white"></div>

      <i class="ph ph-heart mt-1 text-4xl text-white" aria-hidden="true"></i>
    </div>
  </div>
</section>
