---
import { Image } from 'astro:assets';

import palomaHero from '../assets/images/paloma.png';
---

<section id="hero" 
  class="
    overflow-hidden
    bg-black
    text-white
  "
>
  <div
    class="
      mx-auto
    grid
    w-full
    max-w-7xl
    grid-cols-1
    pt-24
    lg:grid-cols-12
    lg:pt-20
    "
  >
    <div
      class="
         relative
    z-10
    flex
    flex-col
    justify-center
    px-4
    pt-8
    pb-8
    sm:px-6
    sm:pt-10
    sm:pb-10
    md:px-10
    lg:col-span-6
    lg:pt-12
    lg:pr-12
    lg:pb-10
      "
    >
      <div
        class="
          mb-7
          flex
          items-center
          gap-4
        "
      >
        <p
          class="
            text-xs
            font-medium
            uppercase
            tracking-widest
            text-white/70
            sm:text-sm
          "
        >
          Senior Frontend Engineer
        </p>

        <span
          aria-hidden="true"
          class="
            h-px
            w-8
            shrink-0
            bg-emerald-500
            sm:w-10
          "
        ></span>
      </div>

      <h1
        class="
          max-w-2xl
          text-4xl
          leading-none
          font-medium
          tracking-tight
          sm:text-5xl
          md:text-6xl
          lg:text-7xl
        "
      >
        Making Complex

        <span class="block">
          Things Feel
        </span>

        <span class="block">
          Obvious<span
            class="text-yellow-300"
            aria-hidden="true"
          >.</span>
        </span>
      </h1>

      <p
        class="
          mt-7
          max-w-lg
          text-base
          leading-relaxed
          text-white/70
          sm:mt-8
          sm:text-lg
        "
      >
        I build accessible, scalable frontend experiences
        with React, TypeScript and thoughtful architecture.
      </p>

      <div
        class="
          mt-8
          flex
          w-full
          flex-col
          gap-3
          sm:mt-10
          sm:w-auto
          sm:flex-row
        "
      >
        <a
          href="/talk"
          class="
            inline-flex
            min-h-12
            w-full
            items-center
            justify-between
            gap-6
            bg-yellow-300
            px-6
            py-3
            text-xs
            font-black
            tracking-wider
            text-black
            transition-colors
            duration-200
            hover:bg-emerald-500
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300
            sm:w-auto
            rounded-full
          "
        >
          <span>
            LET'S TALK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            →
          </span>
        </a>

        <a
          href="/work"
          class="
            inline-flex
            min-h-12
            w-full
            items-center
            justify-between
            gap-6
            border
            border-white/30
            px-6
            py-3
            text-xs
            font-black
            tracking-wider
            text-white
            transition-colors
            duration-200
            hover:border-yellow-300
            hover:text-yellow-300
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300
            sm:w-auto
            rounded-full
          "
        >
          <span>
            VIEW WORK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            ↗
          </span>
        </a>
      </div>
    
    </div>

    <div
      class="
        relative
        flex
        min-h-96
        items-end
        justify-center
        overflow-hidden
        px-4
        sm:px-6
        lg:col-span-6
        lg:min-h-full
        lg:justify-end
        lg:px-0
      "
    >
      <Image
        src={palomaHero}
        alt="Paloma Macedo, Senior Frontend Engineer"
        widths={[480, 640, 768, 960]}
        sizes="(max-width: 1023px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
        class="
          h-auto
          w-full
          max-w-2xl
          object-contain
          object-bottom
          lg:max-w-3xl
        "
      />
      
    </div>
    <a
  href="#expertise"
  class="scroll-mouse group absolute bottom-44 left-1/2 z-30
         flex -translate-x-1/2 flex-col items-center gap-2
         text-emerald-500
         transition-colors duration-300
         hover:text-white
         focus-visible:outline-2
         focus-visible:outline-offset-4
         focus-visible:outline-emerald-500"
  aria-label="Scroll to content"
>
  <span class="mouse-icon" aria-hidden="true">
    <span class="mouse-wheel"></span>
  </span>

  <span
    class="font-mono text-[10px] font-bold uppercase
           tracking-[0.25em]"
  >
    Scroll
  </span>
</a>
  </div>
</section>

<style>
  .scroll-mouse {
    animation: mouse-float 2.5s ease-in-out infinite;
  }

  .mouse-icon {
    position: relative;

    width: 30px;
    height: 48px;

    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .mouse-wheel {
    position: absolute;

    top: 8px;
    left: 50%;

    width: 2px;
    height: 9px;

    border-radius: 999px;

    background: currentColor;

    transform: translateX(-50%);

    animation: mouse-wheel 1.8s ease-in-out infinite;
  }

  @keyframes mouse-wheel {
    0% {
      opacity: 0;
      transform: translate(-50%, 0);
    }

    30% {
      opacity: 1;
    }

    70% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(-50%, 13px);
    }
  }

  @keyframes mouse-float {
    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, 5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-mouse,
    .mouse-wheel {
      animation: none;
    }
  }
</style>