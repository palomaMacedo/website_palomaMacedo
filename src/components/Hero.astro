---
import { Image } from 'astro:assets';

import palomaHero from '../assets/images/paloma.png';
---

<section
  id="hero"
  class="
    overflow-hidden
    bg-black
    text-white
  "
>
  <div
    class="
      mx-auto
      grid
      w-full
      max-w-7xl
      grid-cols-1
      pt-28
      lg:grid-cols-12
      lg:pt-24
    "
  >
    <!-- =================================================
         CONTENT
    ================================================== -->

    <div
      class="
        relative
        z-10
        flex
        flex-col
        justify-center
        px-4
        pt-8
        pb-14
        sm:px-6
        sm:pt-10
        sm:pb-16
        md:px-10
        lg:col-span-6
        lg:pt-12
        lg:pr-12
        lg:pb-20
      "
    >
      <!-- =================================================
           EYEBROW
      ================================================== -->

      <div
        class="
          mb-6
          flex
          items-center
          gap-4
        "
      >
        <p
          class="
            text-xs
            font-medium
            uppercase
            tracking-widest
            text-white/60
          "
        >
          Senior Frontend Engineer
        </p>

        <span
          aria-hidden="true"
          class="
            h-px
            w-10
            bg-emerald-500
          "
        ></span>
      </div>

      <!-- =================================================
           TITLE
      ================================================== -->

      <h1
        class="
          max-w-xl
          text-5xl
          leading-none
          font-medium
          tracking-tight
          sm:text-6xl
          lg:text-7xl
        "
      >
        Making Complex

        <span class="block">
          Things Feel
        </span>

        <span class="block">
          Obvious<span
            class="text-yellow-300"
            aria-hidden="true"
          >.</span>
        </span>
      </h1>

      <!-- =================================================
           DESCRIPTION
      ================================================== -->

      <p
        class="
          mt-8
          max-w-lg
          text-base
          leading-relaxed
          text-white/70
          sm:text-lg
        "
      >
        I build accessible, scalable frontend experiences
        with React, TypeScript and thoughtful architecture.
      </p>

      <!-- =================================================
           BUTTONS
      ================================================== -->

      <div
        class="
          mt-9
          flex
          flex-col
          gap-3
          sm:flex-row
        "
      >
        <!-- LET'S TALK -->

        <a
          href="/talk"
          class="
            inline-flex
            min-h-12
            items-center
            justify-between
            gap-8
            bg-yellow-300
            px-6
            py-3
            text-xs
            font-black
            tracking-wide
            text-black
            transition-colors
            duration-200
            hover:bg-yellow-200
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300
          "
        >
          <span>
            LET'S TALK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            →
          </span>
        </a>

        <!-- VIEW WORK -->

        <a
          href="/work"
          class="
            inline-flex
            min-h-12
            items-center
            justify-between
            gap-8
            border
            border-white/30
            px-6
            py-3
            text-xs
            font-black
            tracking-wide
            text-white
            transition-colors
            duration-200
            hover:border-yellow-300
            hover:text-yellow-300
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300
          "
        >
          <span>
            VIEW WORK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            ↗
          </span>
        </a>
      </div>

      <!-- =================================================
           SCROLL
      ================================================== -->

      <a
        href="#contents"
        class="
          mt-14
          inline-flex
          w-fit
          items-center
          gap-2
          text-xs
          font-bold
          uppercase
          tracking-wider
          text-white/70
          transition-colors
          hover:text-white
          lg:mt-20
        "
      >
        <span>
          Scroll down
        </span>

        <span
          aria-hidden="true"
          class="
            text-emerald-500
          "
        >
          ↓
        </span>
      </a>
    </div>

    <!-- =================================================
         PORTRAIT
    ================================================== -->

    <div
      class="
        relative
        flex
        min-h-96
        items-end
        justify-center
        overflow-hidden
        px-4
        sm:px-6
        lg:col-span-6
        lg:min-h-full
        lg:px-0
      "
    >
      <Image
        src={palomaHero}
        alt="Paloma Macedo, Senior Frontend Engineer"
        widths={[480, 640, 768, 960]}
        sizes="
          (max-width: 1023px) 100vw,
          50vw
        "
        loading="eager"
        fetchpriority="high"
        class="
          h-auto
          w-full
          max-w-2xl
          object-contain
          object-bottom
        "
      />
    </div>
  </div>
</section>