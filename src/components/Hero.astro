---
import { Image } from 'astro:assets';

import palomaHero from '../assets/images/paloma.png';
---

<section
  id="hero"
  class="
    overflow-hidden
    bg-black
    text-white
  "
>
  <div
    class="
      relative
      mx-auto
      grid
      w-full
      max-w-7xl
      grid-cols-1
      pt-24
      lg:min-h-[calc(100svh-80px)]
      lg:grid-cols-12
      lg:pt-20
    "
  >
    <!-- LEFT: PRESENTATION -->
    <div
      class="
        relative
        z-20
        flex
        flex-col
        justify-center
        px-4
        pt-8
        pb-8
        sm:px-6
        sm:pt-10
        sm:pb-10
        md:px-10
        lg:col-span-6
        lg:pt-12
        lg:pr-12
        lg:pb-20
      "
    >
      <!-- ROLE -->
      <div
        class="
          my-7
          flex
          items-center
          gap-4
        "
      >
        <p
          class="
            text-xs
            font-medium
            tracking-widest
            text-white/70
            uppercase
            sm:text-sm
          "
        >
          Senior Frontend Engineer & Web Architect
        </p>

        <span
          aria-hidden="true"
          class="
            h-px
            w-8
            shrink-0
            bg-emerald-500
            sm:w-10
          "
        ></span>
      </div>

      <!-- HEADLINE -->
      <h1
        class="
          max-w-2xl
          text-4xl
          leading-none
          font-medium
          tracking-tight
          sm:text-5xl
          md:text-6xl
          lg:text-7xl
        "
      >
        Hello,

        <span class="block text-yellow-300">
         everyone!
        </span>

      
      </h1>

      <!-- STORYTELLING -->
      <div
        class="
          mt-7
          max-w-lg
          space-y-3
          text-base
          leading-relaxed
          text-white/70
          sm:mt-8
          sm:text-lg
        "
      >
        <p>
          I'm Paloma Macedo, a Senior Frontend Engineer & Web Architect
          with 18 years of experience building and modernizing web applications.
        </p>

        <p>
          My journey started with design and the web. Over time, I moved
          deeper into frontend engineering, solution architecture,
          and user experience.
        </p>

        <p>
          Across 50+ projects, I've connected engineering, accessibility,
          performance, and SEO.
        </p>
      </div>

      <!-- EXPERIENCE HIGHLIGHTS -->
      <div
        class="
          mt-8
          grid
          grid-cols-3
          gap-3
          border-t
          border-white/15
          pt-6
          sm:mt-10
          sm:gap-5
        "
      >
        <div>
          <p class="text-2xl font-semibold text-yellow-300 sm:text-3xl">
            18+
          </p>

          <p
            class="
              mt-1
              text-[10px]
              tracking-wider
              text-white/60
              uppercase
              sm:text-xs
            "
          >
            Years
          </p>

          <p class="mt-1 text-xs text-white/70">
            Building for the Web
          </p>
        </div>

        <div>
          <p class="text-2xl font-semibold text-yellow-300 sm:text-3xl">
            50+
          </p>

          <p
            class="
              mt-1
              text-[10px]
              tracking-wider
              text-white/60
              uppercase
              sm:text-xs
            "
          >
            Projects
          </p>

          <p class="mt-1 text-xs text-white/70">
            Across Industries
          </p>
        </div>

        
      </div>

      <!-- CALLS TO ACTION -->
      <div
        class="
          mt-8
          flex
          w-full
          flex-col
          gap-3
          sm:mt-10
          sm:w-auto
          sm:flex-row
        "
      >
        <a 
          href="https://www.linkedin.com/in/palomamacedofrontend/" 
          target="_blank"
          class="
            inline-flex
            min-h-12
            w-full
            items-center
            justify-between
            gap-6
            rounded-full
            bg-yellow-300
            px-6
            py-3
            text-xs
            font-black
            tracking-wider
            text-black
            transition-colors
            duration-200
            hover:bg-emerald-500
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300
            sm:w-auto
          "
        >
          <span class="flex items-center gap-2">
            <i class="ph-duotone ph-linkedin-logo text-3xl"></i>
            LET'S TALK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            →
          </span>
        </a>

        <a
          href="/work"
          class="
            inline-flex
            min-h-12
            w-full
            items-center
            justify-between
            gap-6
            rounded-full
            border
            border-white/30
            px-6
            py-3
            text-xs
            font-black
            tracking-wider
            text-white
            transition-colors
            duration-200
            hover:border-yellow-300
            hover:text-yellow-300
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300
            sm:w-auto
          "
        >
          <span>VIEW WORK</span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            ↗
          </span>
        </a>
      </div>
    </div>

    <!-- RIGHT: PHOTO + CODE BACKGROUND -->
    <div
      class="
        relative
        flex
        min-h-96
        items-end
        justify-center
        overflow-hidden
        px-4
        sm:px-6
        lg:col-span-6
        lg:min-h-[calc(100svh-80px)]
        lg:justify-end
        lg:px-0
      "
    >
      <!-- CODE BACKGROUND -->
      <div
        aria-hidden="true"
        class="
          pointer-events-none
          absolute
          inset-0
          z-0
          hidden
          items-center
          justify-center
          overflow-hidden
          lg:flex
        "
      >
        <pre
          class="
            translate-x-10
            select-none
            font-mono
            text-sm
            leading-7
            whitespace-pre
            opacity-[0.12]
            xl:translate-x-16
            xl:text-base
            xl:leading-8
          "
        ><code><span class="text-white/70">const</span> <span class="text-yellow-300">problem</span> <span class="text-white/70">=</span> <span class="text-emerald-500">understand</span><span class="text-white/70">();</span>

<span class="text-white/70">const</span> <span class="text-yellow-300">solution</span> <span class="text-white/70">=</span> <span class="text-emerald-500">connect</span><span class="text-white/70">(&#123;</span>
  <span class="text-white">design</span><span class="text-white/70">,</span>
  <span class="text-white">engineering</span><span class="text-white/70">,</span>
  <span class="text-white">architecture</span><span class="text-white/70">,</span>
  <span class="text-white">ai</span><span class="text-white/70">,</span>
<span class="text-white/70">&#125;);</span>

<span class="text-emerald-500">build</span><span class="text-white/70">(solution);</span></code></pre>
      </div>

      <!-- PHOTO GRADIENT -->
      <div
        aria-hidden="true"
        class="
          pointer-events-none
          absolute
          inset-0
          z-[1]
          bg-gradient-to-t
          from-black/20
          via-transparent
          to-transparent
        "
      ></div>

      <!-- PALOMA PHOTO - PRESERVED -->
      <Image
        src={palomaHero}
        alt="Paloma Macedo, Senior Frontend Engineer"
        widths={[480, 640, 768, 960]}
        sizes="(max-width: 1023px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
        class="
          relative
          z-10
          h-auto
          w-full
          object-contain
          object-bottom
          lg:max-w-2xl
        "
      />
    </div>

    <!-- SCROLL INDICATOR -->
    <a
      href="#expertise"
      aria-label="Scroll to expertise"
      class="
        scroll-mouse
        absolute
        bottom-8
        left-1/2
        z-30
        hidden
        flex-col
        items-center
        gap-2
        text-emerald-500
        transition-colors
        duration-300
        hover:text-white
        focus-visible:outline-2
        focus-visible:outline-offset-4
        focus-visible:outline-emerald-500
        lg:flex
      "
    >
      <span
        aria-hidden="true"
        class="mouse-icon"
      >
        <span class="mouse-wheel"></span>
      </span>

      <span
        class="
          font-mono
          text-[10px]
          font-bold
          tracking-[0.25em]
          uppercase
        "
      >
        Scroll
      </span>
    </a>
  </div>
</section>

<style>
  .scroll-mouse {
    transform: translateX(-50%);
    animation: mouse-float 2.5s ease-in-out infinite;
  }

  .mouse-icon {
    position: relative;
    display: block;
    width: 30px;
    height: 48px;
    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .mouse-wheel {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 2px;
    height: 9px;
    border-radius: 999px;
    background: currentColor;
    transform: translateX(-50%);
    animation: mouse-wheel 1.8s ease-in-out infinite;
  }

  @keyframes mouse-wheel {
    0% {
      opacity: 0;
      transform: translate(-50%, 0);
    }

    30% {
      opacity: 1;
    }

    70% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(-50%, 13px);
    }
  }

  @keyframes mouse-float {
    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, 4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-mouse,
    .mouse-wheel {
      animation: none;
    }
  }
</style>