---
import { Image } from 'astro:assets';

import palomaHero from '../assets/images/paloma.png';
---

<section
  id="hero"
  class="
    overflow-hidden
    bg-black
    text-white
  "
>
  <div
    class="
      mx-auto
      grid
      w-full
      max-w-7xl
      grid-cols-1
      lg:grid-cols-12
    "
  >


    <div
      class="
        relative
        z-10
        flex
        flex-col
        justify-center

        px-4
        py-14

        sm:px-6
        sm:py-16

        md:px-10
        md:py-20

        lg:col-span-6
        lg:py-24
        lg:pr-12
      "
    >
   

      <div
        class="
          mb-7
          flex
          items-center
          gap-4
        "
      >
        <p
          class="
            text-xs
            font-medium
            uppercase
            tracking-widest
            text-white/80

            sm:text-sm
          "
        >
          Senior Frontend Engineer
        </p>

        <span
          aria-hidden="true"
          class="
            h-px
            w-8
            shrink-0
            bg-emerald-500

            sm:w-10
          "
        ></span>
      </div>

 

      <h1
        class="
          max-w-2xl

          text-4xl
          leading-none
          font-medium
          tracking-tight

          sm:text-5xl
          md:text-6xl
          lg:text-7xl
        "
      >
        Making Complex
        <span class="block">
          Things Feel Obvious<span
            class="text-yellow-300"
            aria-hidden="true"
          >.</span>
        </span>
      </h1>

      <p
        class="
          mt-7
          max-w-lg

          text-base
          leading-relaxed
          text-white/70

          sm:mt-8
          sm:text-lg
        "
      >
        I build accessible, scalable frontend experiences
        with React, TypeScript and thoughtful architecture.
      </p>

      <div
        class="
          mt-8
          flex
          w-full
          flex-col
          gap-3

          sm:mt-10
          sm:w-auto
          sm:flex-row
        "
      >
   

        <a
          href="/talk"
          class="
            inline-flex
            min-h-12
            w-full
            items-center
            justify-between
            gap-6

            bg-yellow-300

            px-6
            py-3

            text-xs
            font-black
            tracking-wider
            text-black

            transition-colors
            duration-200

            hover:bg-yellow-200

            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300

            sm:w-auto
          "
        >
          <span>
            LET'S TALK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            →
          </span>
        </a>



        <a
          href="/work"
          class="
            inline-flex
            min-h-12
            w-full
            items-center
            justify-between
            gap-6

            border
            border-white/30

            px-6
            py-3

            text-xs
            font-black
            tracking-wider
            text-white

            transition-colors
            duration-200

            hover:border-yellow-300
            hover:text-yellow-300

            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-yellow-300

            sm:w-auto
          "
        >
          <span>
            VIEW WORK
          </span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            ↗
          </span>
        </a>
      </div>
    </div>



    <div
      class="
        relative
        min-h-96
        overflow-hidden

        sm:min-h-screen

        lg:col-span-6
        lg:min-h-full
      "
    >
      <Image
        src={palomaHero}
        alt="Paloma Macedo, Senior Frontend Engineer"
        widths={[480, 640, 768, 960]}
        sizes="
          (max-width: 1023px) 100vw,
          50vw
        "
        loading="eager"
        fetchpriority="high"
        class="
          absolute
          inset-0
          h-full
          w-full
          object-cover
          object-top
        "
      />

    
      <div
        aria-hidden="true"
        class="
          pointer-events-none
          absolute
          inset-y-0
          left-0
          hidden
          w-24

          bg-linear-to-r
          from-black
          to-transparent

          lg:block
        "
      ></div>
    </div>
  </div>
</section>