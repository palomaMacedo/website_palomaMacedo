---
import { Image } from 'astro:assets';

import logoLinkedin from '../assets/images/linkedin-logo.svg';
import logoChat from '../assets/images/chats.svg';
const pathname = Astro.url.pathname;

type Locale = 'en' | 'es' | 'pt-BR';

const currentLocale: Locale =
  pathname === '/es' || pathname.startsWith('/es/')
    ? 'es'
    : pathname === '/pt-br' || pathname.startsWith('/pt-br/')
      ? 'pt-BR'
      : 'en';

const languages = [
  {
    code: 'EN',
    locale: 'en' as const,
    label: 'English',
  },
  {
    code: 'ES',
    locale: 'es' as const,
    label: 'Español',
  },
  {
    code: 'PT',
    locale: 'pt-BR' as const,
    label: 'Português',
  },
];

const removeLocalePrefix = (path: string) => {
  const cleanPath = path.replace(/^\/(es|pt-br)(?=\/|$)/, '');

  return cleanPath || '/';
};

const basePath = removeLocalePrefix(pathname);

const localePath = (locale: Locale) => {
  if (locale === 'en') {
    return basePath;
  }

  const prefix =
    locale === 'es'
      ? '/es'
      : '/pt-br';

  return basePath === '/'
    ? prefix
    : `${prefix}${basePath}`;
};

const localize = (path: string) => {
  if (currentLocale === 'en') {
    return path;
  }

  const prefix =
    currentLocale === 'es'
      ? '/es'
      : '/pt-br';

  if (path === '/') {
    return prefix;
  }

  return `${prefix}${path}`;
};

const navItems = [
  {
    label: 'WORK',
    href: localize('/work'),
  },
  {
    label: 'EXPERIENCE',
    href: localize('/experience'),
  },
];

const talkHref = localize('/talk');

const isActive = (href: string) =>
  pathname === href ||
  pathname.startsWith(`${href}/`);
---

<header
  class="
    fixed
    inset-x-0
    top-0
    z-50
    w-full
    border-b
    border-white/10
    bg-black/70
    text-white
    backdrop-blur-md
  "
  data-header
>
  <div
    class="
      mx-auto
      flex
      w-full
      max-w-7xl
      items-center
      justify-between
      px-4
      py-3
      sm:px-6
      md:px-10
      md:py-4
    "
  >
    <a
      href={localize('/')}
      aria-label="La Loma.dev - Home"
      class="
        relative
        z-50
        shrink-0
        font-sans
        text-2xl
        leading-none
        font-black
        tracking-tighter
        text-white
        sm:text-3xl
      "
    >
      <span class="block">
        La
      </span>

      <span class="block">
        loma
      </span>

      <span class="block">
        <span class="text-yellow-300">.</span>dev<span
          class="text-emerald-500"
        >_</span>
      </span>
    </a>

    <nav
      aria-label="Main navigation"
      class="
        hidden
        items-center
        gap-5
        md:flex
        lg:gap-6
      "
    >
      <ul
        class="
          flex
          items-center
          gap-5
          lg:gap-6
        "
      >
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  isActive(item.href)
                    ? 'page'
                    : undefined
                }
                class:list={[
                  `
                    relative
                    py-2
                    text-xs
                    font-bold
                    tracking-wide
                    transition-colors
                    duration-200
                    hover:text-yellow-300
                    focus-visible:outline-2
                    focus-visible:outline-offset-4
                    focus-visible:outline-yellow-300
                  `,
                  isActive(item.href)
                    ? `
                        text-yellow-300
                        after:absolute
                        after:right-0
                        after:-bottom-0.5
                        after:left-0
                        after:h-px
                        after:bg-yellow-300
                      `
                    : 'text-white',
                ]}
              >
                <span class="text-emerald-500">//  </span>{item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div
        class="
          relative
          flex
          items-center
          border-l
          border-white/20
          pl-5
        "
      >
        <label
          for="language-select"
          class="sr-only"
        >
          Select language
        </label>

        <select
          id="language-select"
          data-language-select
          aria-label="Select language"
          class="
            cursor-pointer
            appearance-none
            bg-transparent
            py-2
            pr-6
            text-xs
            font-bold
            tracking-wide
            text-white
            outline-none
            transition-colors
            duration-200
            hover:text-yellow-300
            focus:text-yellow-300
          "
        >
          {
            languages.map((language) => (
              <option
                value={localePath(language.locale)}
                selected={currentLocale === language.locale}
                lang={language.locale}
                class="
                  bg-black
                  text-white
                "
              >
                {language.code}
              </option>
            ))
          }
        </select>

        <span
          aria-hidden="true"
          class="
            pointer-events-none
            absolute
            right-0
            text-xs
            text-yellow-300
          "
        >
          ↓
        </span>
      </div>

    
       <a
        href="mailto:macedo.paloma@gmail.com?subject=🤘 Hi Paloma, I'd like to hire you"
        class="
          inline-flex
          min-h-10
          items-center
          justify-center
          bg-yellow-300
          px-1.5
          py-1.5
          text-xs
          font-black
          tracking-wide
          text-black
          transition-colors
          duration-200
          hover:bg-emerald-500
          focus-visible:outline-2
          focus-visible:outline-offset-4
          focus-visible:outline-yellow-300
          rounded-full
        "
      >

       <Image
        src={ logoChat}
        alt="Paloma Macedo, Senior Frontend Engineer"
        width="32"
        height="32"
        class="
        size-8
        object-contain
        sm:size-10"
        />
      
      </a>
    </nav>

    <button
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
      class="
        relative
        z-50
        flex
        size-11
        items-center
        justify-center
        md:hidden
      "
    >
      <span class="sr-only">
        Menu
      </span>

      <span
        class="
          relative
          block
          h-4
          w-7
        "
      >
        <span
          data-menu-line="top"
          class="
            absolute
            top-0
            left-0
            block
            h-0.5
            w-7
            bg-white
            transition-transform
            duration-300
          "
        ></span>

        <span
          data-menu-line="bottom"
          class="
            absolute
            bottom-0
            left-0
            block
            h-0.5
            w-7
            bg-white
            transition-transform
            duration-300
          "
        ></span>
      </span>
    </button>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    hidden
    class="
      fixed
      inset-x-0
      bottom-0
      z-40
      overflow-y-auto
      bg-black/95
      backdrop-blur-md
      md:hidden
    "
  >
    <nav
      aria-label="Mobile navigation"
      class="
        mx-auto
        flex
        min-h-full
        w-full
        max-w-7xl
        flex-col
        px-4
        pt-4
        pb-8
        sm:px-6
      "
    >
      <ul class="flex flex-col">
        {
          navItems.map((item) => (
            <li
              class="
                border-b
                border-white/10
              "
            >
              <a
                href={item.href}
                data-mobile-link
                aria-current={
                  isActive(item.href)
                    ? 'page'
                    : undefined
                }
                class:list={[
                  `
                    flex
                    min-h-16
                    w-full
                    items-center
                    justify-between
                    py-4
                    text-lg
                    font-bold
                    tracking-normal
                    transition-colors
                    duration-200
                    hover:text-yellow-300
                  `,
                  isActive(item.href)
                    ? 'text-yellow-300'
                    : 'text-white',
                ]}
              >
                <span>
                  {item.label}
                </span>

                <span
                  aria-hidden="true"
                  class="
                    text-xl
                    text-yellow-300
                  "
                >
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div
        class="
          mt-7
          flex
          items-center
          justify-between
          border-y
          border-white/10
          py-5
        "
      >
        <span
          class="
            text-xs
            font-bold
            uppercase
            tracking-widest
            text-white/40
          "
        >
          Language
        </span>

        <div
          class="
            flex
            items-center
          "
          aria-label="Select language"
        >
          {
            languages.map((language, index) => (
              <span class="flex items-center">
                {index > 0 && (
                  <span
                    class="
                      mx-3
                      text-white/20
                    "
                    aria-hidden="true"
                  >
                    /
                  </span>
                )}

                <a
                  href={localePath(language.locale)}
                  data-mobile-link
                  lang={language.locale}
                  hreflang={language.locale}
                  aria-label={`Change language to ${language.label}`}
                  aria-current={
                    currentLocale === language.locale
                      ? 'page'
                      : undefined
                  }
                  class:list={[
                    `
                      py-2
                      text-sm
                      font-bold
                      tracking-wide
                      transition-colors
                      duration-200
                      hover:text-yellow-300
                    `,
                    currentLocale === language.locale
                      ? 'text-yellow-300'
                      : 'text-white/50',
                  ]}
                >
                  {language.code}
                </a>
              </span>
            ))
          }
        </div>
      </div>

      <a
        href={talkHref}
        data-mobile-link
        class="
          mt-7
          flex
          min-h-14
          w-full
          items-center
          justify-between
          bg-yellow-300
          px-5
          py-4
          text-sm
          font-black
          tracking-wide
          text-black
          transition-colors
          duration-200
          hover:bg-yellow-200
        "
      >
        <span>
          LET'S TALK
        </span>

        <span
          aria-hidden="true"
          class="text-xl"
        >
          →
        </span>
      </a>
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header =
      document.querySelector('[data-header]');

    if (!(header instanceof HTMLElement)) {
      return;
    }

    if (header.dataset.initialized === 'true') {
      return;
    }

    header.dataset.initialized = 'true';

    const button =
      header.querySelector('[data-menu-button]');

    const menu =
      header.querySelector('[data-mobile-menu]');

    const topLine =
      header.querySelector('[data-menu-line="top"]');

    const bottomLine =
      header.querySelector('[data-menu-line="bottom"]');

    const mobileLinks =
      header.querySelectorAll('[data-mobile-link]');

    const languageSelect =
      header.querySelector('[data-language-select]');

    if (
      !(button instanceof HTMLButtonElement) ||
      !(menu instanceof HTMLElement)
    ) {
      return;
    }

    if (languageSelect instanceof HTMLSelectElement) {
      languageSelect.addEventListener(
        'change',
        () => {
          window.location.href =
            languageSelect.value;
        }
      );
    }

    const updateMenuPosition = () => {
      const rect =
        header.getBoundingClientRect();

      menu.style.top =
        `${rect.bottom}px`;

      menu.style.height =
        `calc(100dvh - ${rect.bottom}px)`;
    };

    const openMenu = () => {
      updateMenuPosition();

      menu.hidden = false;

      button.setAttribute(
        'aria-expanded',
        'true'
      );

      button.setAttribute(
        'aria-label',
        'Close menu'
      );

      if (topLine instanceof HTMLElement) {
        topLine.style.transform =
          'translateY(7px) rotate(45deg)';
      }

      if (bottomLine instanceof HTMLElement) {
        bottomLine.style.transform =
          'translateY(-7px) rotate(-45deg)';
      }

      document.body.style.overflow =
        'hidden';
    };

    const closeMenu = () => {
      menu.hidden = true;

      button.setAttribute(
        'aria-expanded',
        'false'
      );

      button.setAttribute(
        'aria-label',
        'Open menu'
      );

      if (topLine instanceof HTMLElement) {
        topLine.style.transform = '';
      }

      if (bottomLine instanceof HTMLElement) {
        bottomLine.style.transform = '';
      }

      document.body.style.overflow = '';
    };

    button.addEventListener(
      'click',
      () => {
        const isOpen =
          button.getAttribute(
            'aria-expanded'
          ) === 'true';

        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      }
    );

    mobileLinks.forEach((link) => {
      link.addEventListener(
        'click',
        closeMenu
      );
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') {
          return;
        }

        const isOpen =
          button.getAttribute(
            'aria-expanded'
          ) === 'true';

        if (!isOpen) {
          return;
        }

        closeMenu();
        button.focus();
      }
    );

    window.addEventListener(
      'resize',
      () => {
        const isOpen =
          button.getAttribute(
            'aria-expanded'
          ) === 'true';

        if (window.innerWidth >= 768) {
          closeMenu();

          return;
        }

        if (isOpen) {
          updateMenuPosition();
        }
      }
    );
  }

  initHeader();

  document.addEventListener(
    'astro:page-load',
    initHeader
  );
</script>