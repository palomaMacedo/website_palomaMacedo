---
const chapters = [
  {
    number: '01',
    title: 'About',
    description: 'Who I am, what I believe and how I see the world.',
    href: '/about',
    icon: '/icons/about.svg',
    iconAlt: 'Illustration representing About',
  },
  {
    number: '02',
    title: 'Work',
    description: 'Selected projects, case studies and digital experiences.',
    href: '/work',
    icon: '/icons/work.svg',
    iconAlt: 'Illustration representing Work',
  },
  {
    number: '03',
    title: 'Shelf',
    description: 'Books, ideas, tools and things worth keeping.',
    href: '/shelf',
    icon: '/icons/shelf.svg',
    iconAlt: 'Illustration representing Shelf',
  },
  {
    number: '04',
    title: 'Experience',
    description: '15+ years turning problems into meaningful solutions.',
    href: '/experience',
    icon: '/icons/experience.svg',
    iconAlt: 'Illustration representing Experience',
  },
  {
    number: '05',
    title: 'Talk',
    description:
      "Let's connect. I'm always open to new ideas and collaborations.",
    href: '/talk',
    icon: '/icons/talk.svg',
    iconAlt: 'Illustration representing Talk',
  },
];
---

<section
  id="contents"
  aria-labelledby="contents-title"
  class="relative bg-black text-white"
>
  <div class="mx-auto w-full max-w-7xl px-6">
    <div class="grid items-start lg:grid-cols-[30%_70%]">
      <aside
        class="flex min-h-96 flex-col bg-black px-7 py-10 sm:px-10 lg:sticky lg:top-0 lg:h-screen lg:min-h-screen lg:px-12 lg:py-10 xl:px-16"
      >
        <a
          href="#chapter-list"
          class="group inline-flex w-fit items-center gap-2 font-mono text-xs font-black tracking-wide text-white uppercase"
        >
          <span>Scroll down</span>

          <span
            aria-hidden="true"
            class="text-lg text-emerald-500 transition-transform duration-300 group-hover:translate-y-1"
          >
            ↓
          </span>
        </a>

        <div class="mt-24 lg:mt-28">
          <h2
            id="contents-title"
            class="font-display text-2xl font-black text-emerald-500 uppercase md:text-3xl"
          >
            Contents
          </h2>

          <svg
            aria-hidden="true"
            viewBox="0 0 160 20"
            fill="none"
            class="mt-2 w-36 text-yellow-300"
          >
            <path
              d="M3 10C15 1 25 19 38 10S61 1 74 10 98 19 111 10 135 1 157 10"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"></path>
          </svg>

          <p class="mt-7 font-mono text-base leading-relaxed text-white">
            Pick a chapter<br />
            and let’s go.
          </p>
        </div>

        <div class="mt-auto pt-20">
          <span
            aria-hidden="true"
            class="block font-mono text-6xl leading-[0.5] text-emerald-500"
          >
            *
          </span>

          <p
            class="mt-5 max-w-3xs font-mono text-sm leading-relaxed text-white"
          >
            This is not<br />
            just a portfolio.<br />
            It’s a field guide<br />
            to how I think,<br />
            what I build and<br />
            what I explore.
          </p>

          <a
            href="/"
            aria-label="La Loma.dev — Home"
            class="mt-8 inline-block font-mono text-xs font-bold text-white"
          >
            La Loma.dev.<span class="text-emerald-500">_</span>
          </a>
        </div>
      </aside>

      <div id="chapter-list" class="scroll-mt-0 border-black lg:border-l-2">
        {
          chapters.map((chapter, index) => (
            <a
              href={chapter.href}
              class:list={[
                'group grid min-h-40',
                'grid-cols-[58px_52px_1fr]',
                'items-center gap-3 border-b-2 border-black',
                'px-4 py-5 text-black sm:grid-cols-[72px_64px_1fr_36px]',
                'sm:gap-5 sm:px-7 lg:min-h-48 lg:gap-6 lg:px-10 lg:py-8',
                'transition-colors duration-300',
                index % 2 === 0
                  ? 'bg-yellow-300 hover:bg-yellow-200'
                  : 'bg-stone-100 hover:bg-white',
              ]}
            >
              <div>
                <span class="font-display block text-5xl leading-none font-black tracking-[-0.06em] sm:text-6xl">
                  {chapter.number}
                </span>

                <span class="font-display block text-xs font-black uppercase">
                  Chapter
                </span>

                <span
                  aria-hidden="true"
                  class="mt-1 block h-0.5 w-10 bg-emerald-600 sm:w-12"
                />
              </div>

              <div class="flex size-12 items-center justify-center overflow-hidden rounded-full bg-emerald-600 transition-transform duration-300 group-hover:scale-105 group-hover:rotate-6 sm:size-16">
                <img
                  src={chapter.icon}
                  alt={chapter.iconAlt}
                  class="size-12 object-contain sm:size-36"
                  loading="lazy"
                  width="48"
                  height="48"
                />
              </div>

              <div class="min-w-0">
                <h3 class="font-display text-xl font-black uppercase sm:text-2xl">
                  <span class="underline decoration-emerald-600 decoration-2 underline-offset-8">
                    {chapter.title}
                  </span>
                </h3>

                <p class="mt-4 max-w-sm font-mono text-xs leading-relaxed font-semibold">
                  {chapter.description}
                </p>
              </div>

              <span
                aria-hidden="true"
                class="hidden justify-self-end text-4xl font-light transition-transform duration-300 group-hover:translate-x-2 sm:block"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <footer
      class="grid gap-12 border-t border-white/20 bg-black px-7 py-12 text-white sm:px-10 md:grid-cols-3 lg:px-12 xl:px-16"
    >
      <div>
        <h3
          class="font-mono text-xs font-black tracking-wide text-emerald-500 uppercase"
        >
          Note to self:
        </h3>

        <p class="mt-3 font-mono text-sm leading-relaxed">
          Stay curious.<br />
          Keep building.<br />
          Help people.
        </p>

        <span aria-hidden="true" class="mt-3 block h-1 w-16 bg-yellow-300"
        ></span>
      </div>

      <div>
        <p class="font-mono text-xs">
          <span class="text-emerald-500">*</span>
          Prefer the short version?
        </p>

        <a
          href="/paloma-macedo-cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="font-display mt-4 inline-flex items-center gap-3 border-2 border-emerald-500 bg-yellow-300 px-5 py-3 text-sm font-black text-black uppercase shadow-[5px_5px_0_#059669] transition-transform duration-200 hover:-translate-y-1"
        >
          View my CV

          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div>
        <h3
          class="font-mono text-xs font-black tracking-wide text-emerald-500 uppercase"
        >
          Let’s connect
        </h3>

        <nav aria-label="Social networks" class="mt-5 flex items-center gap-6">
          <a
            href="https://www.linkedin.com/in/palomamacedofrontend/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex size-9 items-center justify-center text-white transition-colors hover:text-emerald-500"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-6"
            >
              <path
                d="M6.5 8.5H3.3V19h3.2V8.5ZM4.9 3A1.9 1.9 0 1 0 5 6.8 1.9 1.9 0 0 0 4.9 3ZM19.5 13c0-3.2-1.7-4.7-4-4.7a3.5 3.5 0 0 0-3.2 1.8V8.5H9.1V19h3.2v-5.2c0-1.4.3-2.8 2.1-2.8s1.9 1.6 1.9 2.9V19h3.2v-6Z"
              ></path>
            </svg>
          </a>

          <a
            href="https://github.com/palomaMacedo"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="flex size-9 items-center justify-center text-white transition-colors hover:text-emerald-500"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-6"
            >
              <path
                fill-rule="evenodd"
                d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.7 9.7 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.6 4.9.4.3.7.9.7 1.8V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
                clip-rule="evenodd"></path>
            </svg>
          </a>

          <a
            href="mailto:macedo.paloma@gmail.com?subject=🤘 Hi Pam, I'd like to get in touch" 
            rel="noopener noreferrer"
            aria-label="Send an email"
            class="flex size-9 items-center justify-center text-white transition-colors hover:text-emerald-500"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="size-6"
            >
              <rect x="3" y="5" width="18" height="14" rx="1"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </a>
        </nav>
      </div>
    </footer>
  </div>
</section>
