---
const items = [
  {
    number: '01',
    title: 'About',
    description: 'Who I am, what I believe and how I see the world.',
    icon: '/icons/about.svg',
    href: '/about',
  },
  {
    number: '02',
    title: 'Work',
    description: 'Selected projects, case studies and digital experiences.',
    icon: '/icons/work.svg',
    href: '/work',
  },
  {
    number: '03',
    title: 'Experience',
    description: 'Roles, challenges and the path that shaped my work.',
    icon: '/icons/experience.svg',
    href: '/experience',
  },
  {
    number: '04',
    title: 'Shelf',
    description: 'Books, ideas, tools and things worth keeping.',
    icon: '/icons/shelf.svg',
    href: '/shelf',
  },
  {
    number: '05',
    title: 'Talk',
    description: 'Have a project, opportunity or idea? Let’s talk.',
    icon: '/icons/talk.svg',
    href: '/talk',
  },
];
---

<section
  id="expertise"
  class="
    bg-white
    text-black
  "
>
  <div
    class="
      mx-auto
      grid
      w-full
      max-w-7xl
      gap-12
      px-4
      py-16
      sm:px-6
      sm:py-20
      md:px-10
      lg:grid-cols-12
      lg:gap-16
      lg:py-24
    "
  >
    <div
      class="
        lg:col-span-5
      "
    >
      <div
        class="
          flex
          items-center
          gap-4
        "
      >
        <p
          class="
            text-xs
            font-semibold
            uppercase
            tracking-widest
            text-black/50
          "
        >
          What I do
        </p>

        <span
          aria-hidden="true"
          class="
            h-px
            w-10
            bg-emerald-500
          "
        ></span>
      </div>

      <h2
        class="
          mt-6
          max-w-xl
          text-4xl
          leading-tight
          font-medium
          tracking-tight
          sm:text-5xl
          lg:text-6xl
        "
      >
        Frontend engineering that connects product, people and technology.
      </h2>

      <p
        class="
          mt-6
          max-w-lg
          text-base
          leading-relaxed
          text-black/60
          sm:text-lg
        "
      >
        I turn complex requirements into clear, maintainable and scalable
        digital experiences — from architecture and component systems to
        performance, accessibility and technical quality.
      </p>

      <a
        href="/talk"
        class="
          mt-8
          inline-flex
          min-h-12
          w-full
          items-center
          justify-between
          gap-8
          bg-black
          px-6
          py-3
          text-xs
          font-black
          tracking-wide
          text-white
          transition-colors
          duration-200
          hover:bg-emerald-500
          hover:text-black
          focus-visible:outline-2
          focus-visible:outline-offset-4
          focus-visible:outline-black
          sm:w-auto
          rounded-full
        "
      >
        <span>
          LET'S WORK TOGETHER
        </span>

        <span
          aria-hidden="true"
          class="text-lg"
        >
          →
        </span>
      </a>
    </div>

    <div
      class="
        flex
        flex-col
        gap-4
        lg:col-span-7
      "
    >
      {
        items.map((item) => (
          <a
            href={item.href}
            class="
              group
              flex
              flex-col
              gap-5
              border
              border-black/10
              px-5
              py-5
              transition-colors
              duration-200
              hover:border-black/30
              sm:flex-row
              sm:items-center
              sm:gap-6
              sm:px-7
              sm:py-6
            "
          >
            <span
              class="
                shrink-0
                text-sm
                font-medium
                text-black/50
              "
            >
              {item.number}
            </span>

            <div
              class="
                flex
                size-8
                shrink-0
                items-center
                justify-center
                rounded-full
               
                sm:size-24
              "
            >
              <img
                src={item.icon}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                class="
                  size-8
                  object-contain
                  sm:size-14
                "
              />
            </div>

            <div
              class="
                min-w-0
                flex-1
              "
            >
              <h3
                class="
                  text-lg
                  font-black
                  uppercase
                  tracking-tight
                  text-black
                "
              >
                {item.title}
              </h3>

              <span
                aria-hidden="true"
                class="
                  mt-1
                  block
                  h-0.5
                  w-10
                  bg-emerald-500
                "
              ></span>

              <p
                class="
                  mt-3
                  max-w-xl
                  text-sm
                  leading-relaxed
                  text-black/60
                  sm:text-base
                "
              >
                {item.description}
              </p>
            </div>

            <span
              aria-hidden="true"
              class="
                hidden
                shrink-0
                text-3xl
                transition-transform
                duration-200
                group-hover:translate-x-1
                sm:block
              "
            >
              →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>