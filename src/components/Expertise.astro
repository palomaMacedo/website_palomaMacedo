---

<section
  id="expertise"
  class="bg-white text-black"
>
  <div
    class="
      mx-auto
      grid
      w-full
      max-w-7xl
      gap-12
      px-4
      py-16
      sm:px-6
      sm:py-20
      md:px-10
      lg:grid-cols-12
      lg:gap-16
      lg:py-24
    "
  >
    <!-- LEFT -->
    <div class="lg:col-span-5">
      <div class="flex items-center gap-4">
        <p
          class="
            text-xs
            font-semibold
            uppercase
            tracking-widest
            text-black/50
          "
        >
          What I do
        </p>

        <span
          aria-hidden="true"
          class="h-px w-10 bg-emerald-500"
        ></span>
      </div>

      <h2
        class="
          mt-6
          max-w-xl
          text-4xl
          leading-tight
          font-medium
          tracking-tight
          sm:text-5xl
          lg:text-6xl
        "
      >
        I connect people, technology, and real-world needs.
      </h2>

      <p
        class="
          mt-6
          max-w-lg
          text-base
          leading-relaxed
          text-black/60
          sm:text-lg
        "
      >
        Currently, I’m developing AKTIV+, a platform designed to support
        people with Parkinson’s, their families, and caregivers. I work
        across all areas of the project, from product and UX to frontend,
        backend, architecture, and AI, turning ideas and research into a
        real product.
      </p>

      <a
        href="/talk"
        class="
          mt-8
          inline-flex
          min-h-12
          w-full
          items-center
          justify-between
          gap-8
          rounded-full
          bg-black
          px-6
          py-3
          text-xs
          font-black
          tracking-wide
          text-white
          transition-colors
          duration-200
          hover:bg-emerald-500
          hover:text-black
          focus-visible:outline-2
          focus-visible:outline-offset-4
          focus-visible:outline-black
          sm:w-auto
        "
      >
        <span>LET'S WORK TOGETHER</span>

        <span aria-hidden="true" class="text-lg">
          →
        </span>
      </a>
    </div>

    <!-- RIGHT -->
    <div
      class="
        flex
        flex-col
        gap-4
        lg:col-span-7
      "
    >
      {
        items.map((item) => (
          <article
            class="
              group
              flex
              flex-col
              gap-5
              rounded-4xl
              border
              border-black/10
              px-5
              py-6
              transition-colors
              duration-200
              hover:border-black/30
              hover:bg-emerald-500
              sm:flex-row
              sm:gap-6
              sm:px-7
              sm:py-7
            "
          >
            <span
              class="
                shrink-0
                text-sm
                font-medium
                text-black/50
              "
            >
              {item.number}
            </span>

            <div
              class="
                flex
                size-8
                shrink-0
                items-center
                justify-center
                rounded-full
                sm:size-24
              "
            >
              <i
                class={`${item.icon} text-[32px] leading-none sm:text-[56px]`}
                aria-hidden="true"
              ></i>
            </div>

            <div class="min-w-0 flex-1">
              <h3
                class="
                  text-lg
                  font-black
                  uppercase
                  tracking-tight
                  text-black
                "
              >
                {item.title}
              </h3>

              <span
                aria-hidden="true"
                class="
                  mt-1
                  block
                  h-0.5
                  w-10
                  bg-emerald-500
                  transition-colors
                  group-hover:bg-black
                "
              ></span>

              <p
                class="
                  mt-3
                  max-w-xl
                  whitespace-pre-line
                  text-sm
                  leading-relaxed
                  text-black/60
                  sm:text-base
                "
              >
                {item.description}
              </p>

              <!-- TECHNOLOGIES -->
              <ul
                class="
                  mt-5
                  flex
                  flex-wrap
                  gap-2
                "
                aria-label={`${item.title} technologies`}
              >
                {
                  item.technologies.map((technology) => (
                    <li
                      class="
                        rounded-full
                        border
                        border-black/15
                        px-3
                        py-1.5
                        text-[11px]
                        font-bold
                        uppercase
                        tracking-wide
                        text-black/60
                        transition-colors
                        group-hover:border-black/25
                        group-hover:text-black
                      "
                    >
                      {technology}
                    </li>
                  ))
                }
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>