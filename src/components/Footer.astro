---
const socialLinks = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/palomamacedofrontend',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/palomaMacedo',
  },
];
---

<footer
  class="
    border-t
    border-white/10
    bg-black
    text-white
  "
>
  <div
    class="
      mx-auto
      w-full
      max-w-7xl
      px-4
      py-12
      sm:px-6
      sm:py-16
      md:px-10
      lg:py-20
    "
  >
    <div
      class="
        grid
        gap-12
        lg:grid-cols-12
        lg:gap-16
      "
    >
      <!-- Brand / Introduction -->
      <div
        class="
          lg:col-span-5
        "
      >
        <a
          href="/"
          aria-label="La Loma.dev - Home"
          class="
            inline-block
            font-sans
            text-3xl
            leading-none
            font-black
            tracking-tighter
            text-white
          "
        >
          <span class="block">
            La
          </span>

          <span class="block">
            loma
          </span>

          <span class="block">
            <span class="text-yellow-300">.</span>dev<span
              class="text-emerald-500"
            >_</span>
          </span>
        </a>

        <h2
          class="
            mt-8
            max-w-md
            text-3xl
            leading-tight
            font-medium
            tracking-tight
            sm:text-4xl
            lg:text-5xl
          "
        >
          Let’s build something
          <span class="text-yellow-300">
            useful.
          </span>
        </h2>

        <p
          class="
            mt-5
            max-w-md
            text-sm
            leading-relaxed
            text-white/60
            sm:text-base
          "
        >
          Open to frontend engineering opportunities, meaningful products
          and conversations about technology, architecture and digital
          experiences.
        </p>
      </div>

      <!-- Links -->
      <div
        class="
          flex
          flex-col
          justify-between
          gap-10
          lg:col-span-7
        "
      >
        <div>
          <p
            class="
              text-xs
              font-semibold
              tracking-widest
              text-white/40
              uppercase
            "
          >
            Connect
          </p>

          <nav
            class="
              mt-5
              border-t
              border-white/10
            "
            aria-label="Social networks"
          >
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="
                    group
                    flex
                    items-center
                    justify-between
                    border-b
                    border-white/10
                    py-5
                    transition-colors
                    duration-200
                    hover:text-yellow-300
                    focus-visible:outline-2
                    focus-visible:outline-offset-4
                    focus-visible:outline-yellow-300
                  "
                >
                  <span
                    class="
                      text-lg
                      font-medium
                      sm:text-xl
                    "
                  >
                    {social.label}
                  </span>

                  <span
                    aria-hidden="true"
                    class="
                      text-xl
                      transition-transform
                      duration-200
                      group-hover:-translate-y-1
                      group-hover:translate-x-1
                    "
                  >
                    ↗
                  </span>
                </a>
              ))
            }

            <a
              href="/talk"
              class="
                group
                flex
                items-center
                justify-between
                border-b
                border-white/10
                py-5
                transition-colors
                duration-200
                hover:text-yellow-300
                focus-visible:outline-2
                focus-visible:outline-offset-4
                focus-visible:outline-yellow-300
              "
            >
              <span
                class="
                  text-lg
                  font-medium
                  sm:text-xl
                "
              >
                Let’s Talk
              </span>

              <span
                aria-hidden="true"
                class="
                  text-xl
                  transition-transform
                  duration-200
                  group-hover:translate-x-1
                "
              >
                →
              </span>
            </a>
          </nav>
        </div>

        <!-- Back to top -->
        <div
          class="
            flex
            justify-end
          "
        >
          <a
            href="#hero"
            class="
              group
              inline-flex
              items-center
              gap-3
              text-xs
              font-bold
              tracking-wider
              text-emerald-500
              uppercase
              transition-colors
              duration-200
              hover:text-yellow-300
              focus-visible:outline-2
              focus-visible:outline-offset-4
              focus-visible:outline-emerald-500
            "
          >
            <span>
              Back to top
            </span>

            <span
              aria-hidden="true"
              class="
                transition-transform
                duration-200
                group-hover:-translate-y-1
              "
            >
              ↑
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>