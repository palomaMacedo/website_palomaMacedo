---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    id: 'frontend',
    title: 'Frontend',
    description: 'React, TypeScript, Next.js and modern web development.',
    icon: 'ph-duotone ph-code',
    certificates: [
      {
        title: 'Frontend Developer',
        issuer: 'Platzi',
        year: '2025',
        type: 'Certificate',
        image: '/certificates/frontend-developer.webp',
        credential: '#',
      },
      {
        title: 'React.js Professional',
        issuer: 'Platzi',
        year: '2025',
        type: 'Course',
        image: '/certificates/react-professional.webp',
        credential: '#',
      },
      {
        title: 'TypeScript Advanced',
        issuer: 'Platzi',
        year: '2025',
        type: 'Course',
        image: '/certificates/typescript-advanced.webp',
        credential: '#',
      },
    ],
  },

  {
    id: 'architecture',
    title: 'Architecture',
    description:
      'Design Systems, scalable interfaces and software architecture.',
    icon: 'ph-duotone ph-stack',
    certificates: [],
  },

  {
    id: 'ai',
    title: 'Artificial Intelligence',
    description:
      'AI tools, LLMs, prompting and AI-assisted development.',
    icon: 'ph-duotone ph-brain',
    certificates: [
      {
        title: 'Generative AI',
        issuer: 'Platzi',
        year: '2026',
        type: 'Course',
        image: '/certificates/generative-ai.webp',
        credential: '#',
      },
    ],
  },

  {
    id: 'ux-design',
    title: 'UX & Design',
    description:
      'Product design, interfaces and visual communication.',
    icon: 'ph-duotone ph-palette',
    certificates: [],
  },

  {
    id: 'accessibility',
    title: 'Accessibility',
    description:
      'Inclusive interfaces, WCAG and accessibility practices.',
    icon: 'ph-duotone ph-person-arms-spread',
    certificates: [],
  },

  {
    id: 'seo',
    title: 'Technical SEO',
    description:
      'Core Web Vitals, performance and technical SEO.',
    icon: 'ph-duotone ph-magnifying-glass',
    certificates: [],
  },

  {
    id: 'cloud',
    title: 'Cloud & DevOps',
    description:
      'Cloud, CI/CD, deployment and infrastructure.',
    icon: 'ph-duotone ph-cloud',
    certificates: [],
  },

  {
    id: 'security',
    title: 'Security',
    description:
      'OWASP, web security and cybersecurity.',
    icon: 'ph-duotone ph-shield-check',
    certificates: [],
  },

  {
    id: 'other',
    title: 'Other',
    description:
      'Languages, methodologies and continuous learning.',
    icon: 'ph-duotone ph-books',
    certificates: [],
  },
];
---

<Layout
  title="Certifications & Learning | Paloma Macedo"
  description="Courses, certifications and subjects Paloma Macedo continues exploring across frontend engineering, architecture, AI, accessibility, security and design."
  canonicalPath="/certifications"
>
  <Header />

  <main>

    <!-- =========================================
         HERO
    ========================================== -->
    <section
      aria-labelledby="certifications-title"
      class="bg-white text-black"
    >
      <div
        class="
          mx-auto
          w-full
          max-w-7xl
          px-4
          py-16
          sm:px-6
          sm:py-20
          md:px-10
          lg:py-24
        "
      >
        <div
          class="
            grid
            grid-cols-1
            gap-12
            lg:grid-cols-[minmax(0,2fr)_minmax(240px,1fr)]
            lg:items-end
            lg:gap-20
          "
        >

          <!-- HERO CONTENT -->
          <header class="min-w-0">

            <div class="flex items-center gap-4">
              <p
                class="
                  text-xs
                  font-semibold
                  uppercase
                  tracking-widest
                  text-black/50
                "
              >
                Certifications
              </p>

              <span
                aria-hidden="true"
                class="h-px w-10 bg-emerald-500"
              ></span>
            </div>

            <h1
              id="certifications-title"
              class="
                mt-6
                max-w-4xl
                text-5xl
                font-medium
                leading-[0.95]
                tracking-tight
                sm:text-6xl
                md:text-7xl
                lg:text-[84px]
              "
            >
              Certifications
              <span class="block">& Learning</span>
            </h1>

            <p
              class="
                mt-8
                max-w-2xl
                text-base
                leading-relaxed
                text-black/60
                sm:text-lg
              "
            >
              Learning is part of how I build. Here I collect courses,
              certifications and subjects I continue exploring across
              engineering, design and technology.
            </p>

          </header>


          <!-- SIDE MESSAGE -->
          <aside
            aria-label="Learning note"
            class="
              hidden
              min-w-0
              lg:flex
              lg:items-end
              lg:justify-end
            "
          >
            <div
              class="
                max-w-[210px]
                -rotate-3
                text-xl
                font-black
                uppercase
                leading-[1.15]
                tracking-wide
              "
            >
              New things
              <br />
              keep things
              <br />
              interesting.

              <span
                aria-hidden="true"
                class="
                  mt-5
                  block
                  h-1
                  w-12
                  bg-emerald-500
                "
              ></span>
            </div>
          </aside>

        </div>
      </div>
    </section>


    <!-- =========================================
         TOPICS
    ========================================== -->
    <section
      aria-labelledby="topics-title"
      class="
        border-t
        border-black/10
        bg-white
        text-black
      "
    >
      <div
        class="
          mx-auto
          w-full
          max-w-7xl
          px-4
          py-16
          sm:px-6
          sm:py-20
          md:px-10
          lg:py-24
        "
      >

        <!-- SECTION HEADER -->
        <header class="flex items-center gap-4">

          <h2
            id="topics-title"
            class="
              text-xs
              font-semibold
              uppercase
              tracking-widest
              text-black/50
            "
          >
            Explore by topic
          </h2>

          <span
            aria-hidden="true"
            class="h-px w-10 bg-emerald-500"
          ></span>

        </header>


        <!-- CATEGORY GRID -->
        <ul
          class="
            mt-10
            grid
            list-none
            gap-4
            p-0
            sm:grid-cols-2
            lg:grid-cols-3
          "
        >
          {
            categories.map((category) => (
              <li>

                <button
                  type="button"
                  class="
                    group
                    flex
                    min-h-32
                    w-full
                    items-center
                    gap-5
                    rounded-3xl
                    border
                    border-black/15
                    bg-white
                    px-6
                    py-6
                    text-left
                    transition-all
                    duration-200
                    hover:-translate-y-1
                    hover:border-emerald-500
                    hover:shadow-lg
                    focus-visible:outline-2
                    focus-visible:outline-offset-4
                    focus-visible:outline-emerald-500
                  "
                  aria-haspopup="dialog"
                  aria-controls={`dialog-${category.id}`}
                  data-dialog-open={`dialog-${category.id}`}
                >

                  <!-- ICON -->
                  <span
                    class="
                      flex
                      size-14
                      shrink-0
                      items-center
                      justify-center
                      rounded-full
                      bg-black/[0.04]
                      transition-colors
                      duration-200
                      group-hover:bg-emerald-100
                    "
                    aria-hidden="true"
                  >
                    <i
                      class={`
                        ${category.icon}
                        text-[32px]
                        leading-none
                        text-black
                        transition-colors
                        duration-200
                        group-hover:text-emerald-600
                      `}
                    ></i>
                  </span>


                  <!-- TEXT -->
                  <span class="min-w-0 flex-1">

                    <span
                      class="
                        flex
                        items-center
                        gap-3
                      "
                    >

                      <span
                        class="
                          text-base
                          font-black
                          leading-tight
                          text-black
                        "
                      >
                        {category.title}
                      </span>


                      <!-- COUNT -->
                      <span
                        class="
                          rounded-full
                          bg-black/[0.06]
                          px-2.5
                          py-1
                          text-[11px]
                          font-bold
                          text-black/60
                        "
                      >
                        {category.certificates.length}
                      </span>

                    </span>


                    <span
                      class="
                        mt-2
                        block
                        line-clamp-2
                        text-sm
                        leading-5
                        text-black/50
                      "
                    >
                      {category.description}
                    </span>

                  </span>


                  <!-- ARROW -->
                  <span
                    aria-hidden="true"
                    class="
                      shrink-0
                      text-xl
                      transition-transform
                      duration-200
                      group-hover:translate-x-1
                    "
                  >
                    →
                  </span>

                </button>

              </li>
            ))
          }
        </ul>

      </div>
    </section>


    <!-- =========================================
         DIALOGS
    ========================================== -->
    {
      categories.map((category) => (

        <dialog
          id={`dialog-${category.id}`}
          class="
            m-auto
            w-[calc(100%-2rem)]
            max-w-5xl
            overflow-hidden
            rounded-[2rem]
            bg-white
            p-0
            text-black
            shadow-2xl
          "
        >

          <article
            aria-labelledby={`dialog-title-${category.id}`}
            class="
              relative
              grid
              max-h-[90vh]
              overflow-y-auto
              lg:grid-cols-12
            "
          >

            <!-- CLOSE -->
            <form method="dialog">

              <button
                type="submit"
                aria-label={`Close ${category.title}`}
                class="
                  absolute
                  right-5
                  top-5
                  z-20
                  flex
                  size-10
                  items-center
                  justify-center
                  rounded-full
                  border
                  border-black/10
                  bg-white
                  text-black
                  transition-colors
                  duration-200
                  hover:bg-black
                  hover:text-white
                  focus-visible:outline-2
                  focus-visible:outline-offset-2
                  focus-visible:outline-black
                "
              >
                <i
                  class="
                    ph-duotone
                    ph-x
                    text-xl
                  "
                  aria-hidden="true"
                ></i>
              </button>

            </form>


            <!-- =================================
                 MODAL SIDEBAR
            ================================== -->
            <header
              class="
                border-b
                border-black/10
                p-8
                sm:p-10
                lg:col-span-4
                lg:border-b-0
                lg:border-r
              "
            >

              <!-- ICON -->
              <div
                class="
                  flex
                  size-16
                  items-center
                  justify-center
                  rounded-full
                  bg-emerald-100
                "
              >
                <i
                  class={`
                    ${category.icon}
                    text-[36px]
                    leading-none
                    text-black
                  `}
                  aria-hidden="true"
                ></i>
              </div>


              <!-- TITLE -->
              <h2
                id={`dialog-title-${category.id}`}
                class="
                  mt-6
                  text-3xl
                  font-black
                  leading-none
                  tracking-tight
                "
              >
                {category.title}
              </h2>


              <!-- COUNT -->
              <p
                class="
                  mt-2
                  text-sm
                  font-medium
                  text-black/50
                "
              >
                {category.certificates.length}

                {
                  category.certificates.length === 1
                    ? ' learning credential'
                    : ' learning credentials'
                }
              </p>


              <!-- DESCRIPTION -->
              <p
                class="
                  mt-6
                  text-sm
                  leading-6
                  text-black/60
                "
              >
                {category.description}
              </p>

            </header>


            <!-- =================================
                 CERTIFICATES
            ================================== -->
            <section
              aria-label={`${category.title} certificates`}
              class="
                p-8
                sm:p-10
                lg:col-span-8
              "
            >

              {
                category.certificates.length > 0 ? (

                  <ul
                    class="
                      m-0
                      list-none
                      divide-y
                      divide-black/10
                      p-0
                    "
                  >
                    {
                      category.certificates.map((certificate) => (

                        <li>

                          <article
                            class="
                              grid
                              gap-5
                              py-6
                              first:pt-0
                              sm:grid-cols-[140px_minmax(0,1fr)_auto]
                              sm:items-center
                            "
                          >

                            <!-- IMAGE -->
                            {
                              certificate.image && (

                                <img
                                  src={certificate.image}
                                  alt=""
                                  width="280"
                                  height="180"
                                  loading="lazy"
                                  class="
                                    aspect-[14/9]
                                    w-full
                                    rounded-xl
                                    border
                                    border-black/10
                                    object-cover
                                    sm:w-[140px]
                                  "
                                />

                              )
                            }


                            <!-- INFORMATION -->
                            <div class="min-w-0">

                              <span
                                class:list={[
                                  'inline-flex rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wide',

                                  certificate.type === 'Certificate'
                                    ? 'bg-emerald-100 text-emerald-700'
                                    : 'bg-yellow-100 text-yellow-700',
                                ]}
                              >
                                {certificate.type}
                              </span>


                              <h3
                                class="
                                  mt-2
                                  text-base
                                  font-black
                                  leading-tight
                                  text-black
                                "
                              >
                                {certificate.title}
                              </h3>


                              <p
                                class="
                                  mt-1
                                  text-sm
                                  text-black/50
                                "
                              >
                                {certificate.issuer} · {certificate.year}
                              </p>

                            </div>


                            <!-- CREDENTIAL -->
                            {
                              certificate.credential &&
                              certificate.credential !== '#' && (

                                <a
                                  href={certificate.credential}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="
                                    inline-flex
                                    items-center
                                    gap-2
                                    text-xs
                                    font-bold
                                    text-black
                                    underline
                                    decoration-black/30
                                    underline-offset-4
                                    transition-colors
                                    duration-200
                                    hover:text-emerald-600
                                  "
                                >
                                  View credential

                                  <i
                                    class="
                                      ph-duotone
                                      ph-arrow-square-out
                                      text-base
                                    "
                                    aria-hidden="true"
                                  ></i>
                                </a>

                              )
                            }

                          </article>

                        </li>

                      ))
                    }
                  </ul>

                ) : (

                  <!-- EMPTY STATE -->
                  <div
                    class="
                      flex
                      min-h-72
                      flex-col
                      items-start
                      justify-center
                    "
                  >

                    <i
                      class="
                        ph-duotone
                        ph-books
                        text-5xl
                        text-black/20
                      "
                      aria-hidden="true"
                    ></i>


                    <h3
                      class="
                        mt-5
                        text-xl
                        font-black
                      "
                    >
                      More coming soon.
                    </h3>


                    <p
                      class="
                        mt-2
                        max-w-md
                        text-sm
                        leading-6
                        text-black/50
                      "
                    >
                      I'm still organizing the courses and credentials
                      related to this topic.
                    </p>

                  </div>

                )
              }

            </section>

          </article>

        </dialog>

      ))
    }

  </main>


  <Footer />


  <!-- =========================================
       DIALOG SCRIPT
  ========================================== -->
  <script>
    const openButtons =
      document.querySelectorAll<HTMLButtonElement>(
        '[data-dialog-open]'
      );

    openButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const dialogId = button.dataset.dialogOpen;

        if (!dialogId) return;

        const dialog =
          document.getElementById(
            dialogId
          ) as HTMLDialogElement | null;

        dialog?.showModal();
      });
    });


    const dialogs =
      document.querySelectorAll<HTMLDialogElement>(
        'dialog'
      );

    dialogs.forEach((dialog) => {

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });

    });
  </script>


  <!-- =========================================
       DIALOG STYLES
  ========================================== -->
  <style>
    dialog::backdrop {
      background: rgb(0 0 0 / 0.72);
      backdrop-filter: blur(3px);
    }

    dialog[open] {
      animation: dialog-in 180ms ease-out;
    }

    @keyframes dialog-in {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      dialog[open] {
        animation: none;
      }
    }
  </style>

</Layout>