---


import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';



const principles = [
  {
    number: '01',
    title: 'Idea',
    description:
      'Understanding the problem, the people involved, and what the product really needs before choosing the solution.',
  },
  {
    number: '02',
    title: 'Implementation',
    description:
      'Turning ideas into accessible and maintainable frontend systems with thoughtful architecture.',
  },
  {
    number: '03',
    title: 'Interaction',
    description:
      'Building experiences where technology feels clear, useful, and natural to the people using it.',
  },
];

const skills = [
  'React',
  'TypeScript',
  'Next.js',
  'Frontend Architecture',
  'Design Systems',
  'Accessibility',
  'Technical SEO',
  'Web Performance',
  'AI',
];

const collaborations = [
  'Design',
  'Engineering',
  'DevOps',
  'Cybersecurity',
];
---

<Layout
  title="About | Paloma Macedo — Senior Frontend Engineer"
  description="Senior Frontend Engineer from Rio de Janeiro working across frontend architecture, accessibility, React, TypeScript and AI."
  canonicalPath="/about"
>
  <Header />

  <main
    id="main-content"
    class="
      bg-black
      text-white
    "
  >
 

    <section
      class="
        border-b
        border-white/10
        mt-28
      "
    >
      <div
        class="
          mx-auto
          grid
          min-h-[calc(100svh-80px)]
          w-full
          max-w-7xl
          grid-cols-1
          px-4
          pt-28
          pb-16
          sm:px-6
          md:px-10
          lg:grid-cols-12
          lg:gap-16
          lg:pt-32
          lg:pb-20
        "
      >
       

        <aside
          class="
            lg:col-span-5
          "
        >
          <div
            class="
              lg:sticky
              lg:top-28
            "
          >
   
            <div
              class="
                flex
                items-center
                gap-4
              "
            >
              <span
                aria-hidden="true"
                class="
                  h-px
                  w-8
                  bg-emerald-500
                "
              ></span>

              <p
                class="
                  text-xs
                  font-semibold
                  tracking-[0.2em]
                  text-white/50
                  uppercase
                "
              >
                About me
              </p>
            </div>

      
            <h1
              class="
                mt-7
                max-w-xl
                text-5xl
                leading-[0.95]
                font-medium
                tracking-tight
                sm:text-6xl
                lg:text-7xl
              "
            >
              From idea to

              <span
                class="
                  block
                  text-yellow-300
                "
              >
                implementation
              </span>

              <span class="block">
                and interaction.
              </span>
            </h1>

            <!-- Introduction -->
            <p
              class="
                mt-8
                max-w-md
                text-base
                leading-relaxed
                text-white/60
                sm:text-lg
              "
            >
              Senior Frontend Engineer connecting design, engineering,
              technology and real-world needs.
            </p>

           
            <nav
              aria-label="About sections"
              class="
                mt-10
                hidden
                lg:block
              "
            >
              <ul class="space-y-4">
                <li>
                  <a
                    href="#about"
                    class="
                      group
                      inline-flex
                      items-center
                      gap-4
                      text-xs
                      font-bold
                      tracking-[0.15em]
                      text-white/40
                      uppercase
                      transition-colors
                      duration-200
                      hover:text-white
                    "
                  >
                    <span
                      class="
                        h-px
                        w-8
                        bg-white/30
                        transition-all
                        duration-200
                        group-hover:w-14
                        group-hover:bg-emerald-500
                      "
                    ></span>

                    About
                  </a>
                </li>

                <li>
                  <a
                    href="#what-i-do"
                    class="
                      group
                      inline-flex
                      items-center
                      gap-4
                      text-xs
                      font-bold
                      tracking-[0.15em]
                      text-white/40
                      uppercase
                      transition-colors
                      duration-200
                      hover:text-white
                    "
                  >
                    <span
                      class="
                        h-px
                        w-8
                        bg-white/30
                        transition-all
                        duration-200
                        group-hover:w-14
                        group-hover:bg-emerald-500
                      "
                    ></span>

                    What I do
                  </a>
                </li>

                <li>
                  <a
                    href="#approach"
                    class="
                      group
                      inline-flex
                      items-center
                      gap-4
                      text-xs
                      font-bold
                      tracking-[0.15em]
                      text-white/40
                      uppercase
                      transition-colors
                      duration-200
                      hover:text-white
                    "
                  >
                    <span
                      class="
                        h-px
                        w-8
                        bg-white/30
                        transition-all
                        duration-200
                        group-hover:w-14
                        group-hover:bg-emerald-500
                      "
                    ></span>

                    Approach
                  </a>
                </li>

                <li>
                  <a
                    href="#skills"
                    class="
                      group
                      inline-flex
                      items-center
                      gap-4
                      text-xs
                      font-bold
                      tracking-[0.15em]
                      text-white/40
                      uppercase
                      transition-colors
                      duration-200
                      hover:text-white
                    "
                  >
                    <span
                      class="
                        h-px
                        w-8
                        bg-white/30
                        transition-all
                        duration-200
                        group-hover:w-14
                        group-hover:bg-emerald-500
                      "
                    ></span>

                    Skills
                  </a>
                </li>
              </ul>
            </nav>
           
          </div>
        </aside>

        
        <div
          class="
            mt-16
            lg:col-span-7
            lg:mt-0
          "
        >
          
          <section
            id="about"
            class="
              scroll-mt-28
              border-b
              border-white/10
              pb-16
              lg:pb-20
            "
          >
            <p
              class="
                mb-6
                text-xs
                font-bold
                tracking-[0.2em]
                text-emerald-500
                uppercase
              "
            >
              01 / About
            </p>

            <div
              class="
                space-y-6
                text-lg
                leading-relaxed
                text-white/70
                sm:text-xl
                sm:leading-relaxed
              "
            >
              <p>
                I am a Senior Frontend Engineer with more than 15 years
                of experience and a background that connects design,
                user experience and software engineering.
              </p>

              <p>
                My work starts with understanding the problem and
                turning it into interfaces that are clear, accessible
                and well structured.
              </p>

              <p>
                I enjoy working where design and engineering meet:
                organizing complex ideas, connecting different parts of
                a product and building solutions that make technology
                easier to use.
              </p>
            </div>
          </section>

          
          <section
            id="what-i-do"
            class="
              scroll-mt-28
              border-b
              border-white/10
              py-16
              lg:py-20
            "
          >
            <p
              class="
                mb-6
                text-xs
                font-bold
                tracking-[0.2em]
                text-emerald-500
                uppercase
              "
            >
              02 / What I do
            </p>

            <h2
              class="
                max-w-2xl
                text-3xl
                leading-tight
                font-medium
                tracking-tight
                sm:text-4xl
                lg:text-5xl
              "
            >
              Connecting people, technology,

              <span class="text-yellow-300">
                and real-world needs.
              </span>
            </h2>

            <div
              class="
                mt-8
                space-y-6
                text-base
                leading-relaxed
                text-white/65
                sm:text-lg
              "
            >
              <p>
                Currently, I work as a Senior Frontend Engineer and I am
                developing
                <strong class="font-medium text-white">
                  AKTIV+
                </strong>,
                a platform created to support people with Parkinson’s,
                their families, and caregivers.
              </p>

              <p>
                I am responsible for the development of the project and
                I am integrating artificial intelligence to help
                patients stay active.
              </p>

              <p>
                Throughout my career, I have worked on engineering
                initiatives related to component libraries and frontend
                platforms, collaborating closely with designers,
                engineers, DevOps, and cybersecurity teams.
              </p>
            </div>

          
            <div
              class="
                mt-10
                flex
                flex-wrap
                gap-2
              "
            >
              {
                collaborations.map((item) => (
                  <span
                    class="
                      rounded-full
                      border
                      border-white/10
                      px-4
                      py-2
                      text-xs
                      font-medium
                      text-white/60
                      transition-colors
                      duration-200
                      hover:border-emerald-500
                      hover:text-emerald-500
                    "
                  >
                    {item}
                  </span>
                ))
              }
            </div>
          </section>

          
          <section
            id="approach"
            class="
              scroll-mt-28
              border-b
              border-white/10
              py-16
              lg:py-20
            "
          >
            <p
              class="
                mb-6
                text-xs
                font-bold
                tracking-[0.2em]
                text-emerald-500
                uppercase
              "
            >
              03 / Approach
            </p>

            <h2
              class="
                max-w-2xl
                text-3xl
                leading-tight
                font-medium
                tracking-tight
                sm:text-4xl
                lg:text-5xl
              "
            >
              Idea.

              <span class="text-yellow-300">
                Implementation.
              </span>

              Interaction.
            </h2>

            <div
              class="
                mt-10
                space-y-3
              "
            >
              {
                principles.map((principle) => (
                  <article
                    class="
                      group
                      rounded-3xl
                      border
                      border-white/10
                      p-6
                      transition-all
                      duration-300
                      hover:-translate-y-1
                      hover:border-emerald-500/50
                      hover:bg-white/[0.03]
                      sm:p-8
                    "
                  >
                    <div
                      class="
                        flex
                        items-start
                        gap-5
                      "
                    >
                      <span
                        class="
                          pt-1
                          font-mono
                          text-xs
                          font-bold
                          text-emerald-500
                        "
                      >
                        {principle.number}
                      </span>

                      <div>
                        <h3
                          class="
                            text-xl
                            font-medium
                            text-white
                            sm:text-2xl
                          "
                        >
                          {principle.title}
                        </h3>

                        <p
                          class="
                            mt-3
                            max-w-xl
                            text-sm
                            leading-relaxed
                            text-white/55
                            sm:text-base
                          "
                        >
                          {principle.description}
                        </p>
                      </div>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section
            id="skills"
            class="
              scroll-mt-28
              py-16
              lg:py-20
            "
          >
            <p
              class="
                mb-6
                text-xs
                font-bold
                tracking-[0.2em]
                text-emerald-500
                uppercase
              "
            >
              04 / Skills
            </p>

            <h2
              class="
                max-w-2xl
                text-3xl
                leading-tight
                font-medium
                tracking-tight
                sm:text-4xl
                lg:text-5xl
              "
            >
              Tools are part of the work.

              <span class="text-yellow-300">
                Thinking connects them.
              </span>
            </h2>

            <div
              class="
                mt-10
                flex
                flex-wrap
                gap-3
              "
            >
              {
                skills.map((skill) => (
                  <span
                    class="
                      rounded-full
                      border
                      border-white/15
                      px-5
                      py-3
                      text-sm
                      font-medium
                      text-white/70
                      transition-colors
                      duration-200
                      hover:border-yellow-300
                      hover:text-yellow-300
                    "
                  >
                    {skill}
                  </span>
                ))
              }
            </div>
          </section>
        </div>
      </div>
    </section>

    <!-- ==================================================
         CTA
    =================================================== -->

    <section
      class="
        bg-yellow-300
        text-black
      "
    >
      <div
        class="
          mx-auto
          flex
          w-full
          max-w-7xl
          flex-col
          gap-8
          px-4
          py-16
          sm:px-6
          md:px-10
          lg:flex-row
          lg:items-end
          lg:justify-between
          lg:py-20
        "
      >
        <div>
          <p
            class="
              text-xs
              font-bold
              tracking-[0.2em]
              uppercase
            "
          >
            Let’s talk
          </p>

          <h2
            class="
              mt-4
              max-w-3xl
              text-4xl
              leading-none
              font-medium
              tracking-tight
              sm:text-5xl
              lg:text-6xl
            "
          >
            Have a complex problem?

            <span class="block">
              Let’s make it feel obvious.
            </span>
          </h2>
        </div>

        <a
          href="/talk"
          class="
            inline-flex
            min-h-12
            shrink-0
            items-center
            justify-between
            gap-8
            rounded-full
            bg-black
            px-6
            py-3
            text-xs
            font-black
            tracking-wider
            text-white
            transition-colors
            duration-200
            hover:bg-emerald-500
            hover:text-black
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-black
          "
        >
          <span>LET'S TALK</span>

          <span
            aria-hidden="true"
            class="text-lg"
          >
            →
          </span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>